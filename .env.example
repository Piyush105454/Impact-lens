# ─── App mode ──────────────────────────────────────────────
# true = the full product runs on the built-in demo workspace
# (no AI keys, no database required  ).
NEXT_PUBLIC_DEMO_MODE=true

# ─── AI provider ───────────────────────────────────────────
# demo | gemini | openai
# Falls back to "demo" automatically if the selected provider has no key.
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Cloudinary (media storage) ────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Server-only. Used for signed uploads and asset verification.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Serve demo assets from your Cloudinary account after `npm run seed:cloudinary`
NEXT_PUBLIC_DEMO_ASSETS_FROM_CLOUDINARY=false

# ─── Supabase (database + auth) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
